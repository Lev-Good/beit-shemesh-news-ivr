# שרת
PORT=3000
WEBHOOK_SECRET=replace-with-a-long-random-secret
# ימות: מפתח API קבוע מומלץ, או פרטי התחברות לחשבון
YEMOT_TOKEN=
YEMOT_USERNAME=
YEMOT_PASSWORD=
# קידומת נתיב הקבצים ב-API
YEMOT_PATH_PREFIX=ivr2:
YEMOT_PUBLISH_PATH=1
YEMOT_PREVIEW_PATH=0/0/6/preview
YEMOT_ARCHIVE_PATH=0/0/6/archive
PUBLISH_ORDER_MODE=highest_first
# Groq (תמלול וניסוח מהיר)
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_CHAT_MODEL=openai/gpt-oss-120b
# Gemini (גיבוי לניסוח + קריינות TTS)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# TTS: gemini, edge או azure
TTS_PROVIDER=gemini
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Orus
EDGE_TTS_VOICE=he-IL-AvriNeural
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_TTS_VOICE=he-IL-AvriNeural
# מגבלות ונסיונות חוזרים
MAX_RECORDING_SECONDS=120
MAX_WAIT_SECONDS=40
AI_RETRY_COUNT=2
AI_RETRY_DELAY_MS=3000
YEMOT_RETRY_COUNT=3
YEMOT_RETRY_DELAY_MS=1000
PREVIEW_TTL_HOURS=24
ARCHIVE_RETENTION_DAYS=30
RATE_LIMIT_PER_PHONE_HOUR=10
RATE_LIMIT_GLOBAL_PER_HOUR=120
